# ============================================
# ADC Irradiation Work Order — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- App Config ----
APP_ENV=development            # development | staging | production | test
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# ---- LLM (structured output bắt buộc — ADR-0002) ----
OPENAI_API_KEY=sk-your-key-here
MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=30

# ---- Gemini — đọc PDF, OCR, trích xuất ticket (ADR-0010) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_S=60

# ---- Database ----
DATABASE_URL=sqlite:///./data/app.db
# Staging / production:
# DATABASE_URL=postgresql://user:password@localhost:5432/adc_work_order

# ---- Giả định throughput mô phỏng (ADC-002) ----
THROUGHPUT_CONFIG_PATH=src/config/throughput.yaml
LOCAL_UTC_OFFSET=+07:00        # giờ địa phương hiển thị lịch / lọc theo ngày (ADC-003)

# ---- Upload PDF (ADC-001) ----
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=20

# ---- Google OAuth (ADC-008) — tách client theo môi trường ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Tên miền email được phép, vd: example.com,example.vn — chờ đối tác chốt
ALLOWED_EMAIL_DOMAINS=
# Admin đầu tiên (không có ai để duyệt họ): email, phân tách bằng dấu phẩy
BOOTSTRAP_ADMIN_EMAILS=
SESSION_TTL_HOURS=12           # hết hạn sau N giờ không hoạt động
SESSION_COOKIE_SECURE=true     # chỉ tắt khi test qua http không phải localhost
OAUTH_STATE_TTL_MIN=10
FRONTEND_URL=http://localhost:3000

# ---- Feature flags (dự phòng khi demo/pitch) ----
FEATURE_OCR=true
FEATURE_AI_MESSAGE_DRAFT=true
FEATURE_AI_EXPLANATION=true
FEATURE_DEMO_LOGIN=false       # chỉ bật ở môi trường demo
DEMO_RESET_ENABLED=false       # chỉ bật ở demo/staging
FEATURE_RANDOM_ESTIMATE=false  # DEMO: ước tính thời lượng ngẫu nhiên 4–8h thay mô hình ADC-002

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=adc-irradiation-work-order
LANGCHAIN_TRACING_V2=true

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend (Next.js — frontend/.env.local) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
